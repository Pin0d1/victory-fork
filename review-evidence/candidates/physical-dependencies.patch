+/// Whether any sibling view shows bytes in the requested interval that match
+/// the dependency predicate. Clip both ends to the part of each shared page.
+pub(crate) fn alias_matches(from: usize, to: usize, test: impl Fn(usize, usize) -> bool) -> bool {
+    from < to && aliases(from, to - from).into_iter().any(|(here, there)| {
+        let lo = from.saturating_sub(here);
+        let hi = (to - here).min(K64);
+        test(there + lo, there + hi)
+    })
+}
