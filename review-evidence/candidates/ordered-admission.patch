+fn guest_indirect(
+    state: &mut State,
+    list: &HostList,
+    spec: (u32, u32, u32),
+    address: u64,
+    count: Option<u64>,
+) -> bool {
+    let source = crate::shadow::find(address, 1).expect("registered input");
+    state.execute_indirect(
+        list,
+        spec,
+        &(address..address + source.left(address)),
+        count,
+    )
+}
