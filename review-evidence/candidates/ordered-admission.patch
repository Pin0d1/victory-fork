+pub(crate) fn argument_span(kind: u32, stride: u32, records: u32) -> Option<u64> {
+    let width = match kind {
+        0 => 16,
+        1 => 20,
+        2 | 10 | 105 => 12,
+        _ => return None,
+    };
+    if stride < width || !stride.is_multiple_of(4) {
+        return None;
+    }
+    Some(if records == 0 {
+        0
+    } else {
+        u64::from(records - 1) * u64::from(stride) + u64::from(width)
+    })
+}
