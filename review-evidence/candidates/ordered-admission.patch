+    let producer = host.new_list().unwrap();
+    gpu_store(&producer, args.at(0), 3);
+    gpu_store(&producer, count.at(0), 1);
+    producer.close();
+    let (pixels, stats) = render(&fixture, Some(&producer), |state, list| {
+        assert!(guest_indirect(
