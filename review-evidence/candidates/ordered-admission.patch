+fn ready(pipeline: HostPipeline) -> Box<Pipeline> {
+    let p = Pending::new(Vec::new(), None);
+    assert!(p.made.set(Some(pipeline)).is_ok());
+    Box::new(Pipeline {
+        object: Object::new(&FUNCTIONS),
+        packet: [0; 8],
+        shaders: Vec::new(),
+        bound: AtomicBool::new(false),
+        host: Arc::new(p),
+        builder: false,
+    })
+}
