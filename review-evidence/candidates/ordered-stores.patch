+
+/// What precedes a wait on the host timeline. An earlier matching store
+/// cannot release a wait that follows a later store to the same bytes.
+fn pending_value(address: usize, bytes: usize, writes: &[Late]) -> PendingValue {
+    let Some(end) = address.checked_add(bytes) else {
+        return PendingValue::Settle;
+    };
+    for item in writes.iter().rev() {
+        let Late::Write(at, what, width) = *item else {
+            continue;
+        };
+        if at >= end || at.saturating_add(width) <= address {
+            continue;
+        }
+        if let crate::queue::Written::Value(value) = what
+            && at <= address
+            && end - at <= width
+        {
+            return PendingValue::Known(value >> (8 * (address - at)));
+        }
+        // A timestamp, or a partial overwrite: read the actual bytes after
+        // landing. This also handles a pair of adjacent 32-bit stores.
+        return PendingValue::Settle;
+    }
+    PendingValue::Memory
+}
