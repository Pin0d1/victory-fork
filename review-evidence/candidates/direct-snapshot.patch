+#[cfg(test)]
+mod relay_snapshot_tests {
+    use super::*;
+
+    #[test]
+    fn snapshot_limit_counts_each_committed_allocation() {
+        assert_eq!(snapshot_allocation(0, 4), Some(64 << 10));
+        assert_eq!(snapshot_allocation(SNAPSHOT_LIMIT - 4, 4), None);
+        assert_eq!(snapshot_allocation(0, SNAPSHOT_LIMIT + 1), None);
+        assert_eq!(snapshot_allocation(0, u64::MAX), None);
+    }
+
+    #[test]
+    fn relay_snapshot_pressure_guards_live_bytes_until_the_copy_finishes() {
+        if std::env::var_os("VICTORY_TEST_SNAPSHOT_PRESSURE").is_none() {
+            let thread = std::thread::current();
+            let child = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", thread.name().unwrap(), "--nocapture"])
+                .env("VICTORY_TEST_SNAPSHOT_PRESSURE", "1")
+                .env("VICTORY_RELAY", "2")
+                .env("VICTORY_CARD_BUFFERS", "1")
+                .env("VICTORY_CARD_BUFFERS_MIN_MB", "1")
+                .env("VICTORY_KEEP_SNAPSHOTS", "0")
+                .status().unwrap();
+            assert!(child.success());
+            return;
+        }
+        let host = host().expect("D3D12 device");
+        assert!(relay() && host.card_ready());
+        const WORDS: usize = 1024 * 1024 / 4;
+        let mut title = vec![0u32; WORDS];
+        let address = title.as_mut_ptr() as usize;
+        crate::shadow::register(address, address as u64, (WORDS * 4) as u64);
+        let shadow = crate::shadow::find(address as u64, 4).unwrap();
+        assert!(shadow.carded());
+        let producer = host.new_list().unwrap();
+        shadow.refresh(&producer, address as u64, 4);
+        shadow.gpu_writes(&producer, address as u64, 4);
+        let put = |list: &HostList, word: u32| {
+            let (upload, data) = host.upload_buffer(4).unwrap();
+            // SAFETY: both resources cover the word, and the list retains the upload.
+            unsafe {
+                data.cast::<u32>().write_unaligned(word);
+                list.list.CopyBufferRegion(&shadow.buffer, 0, &upload, 0, 4);
+                list.list.ResourceBarrier(&[transition(&shadow.buffer, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_COMMON)]);
+            }
+            list.keep(&upload);
+        };
+        put(&producer, 17);
+        producer.close();
+        let next = host.new_list().unwrap();
+        put(&next, 29);
+        next.close();
+        CARD_WORK.lock().unwrap().as_mut().unwrap().snapshot_bytes = SNAPSHOT_LIMIT;
+        // Hold the producer in the queue. A separate thread always opens the gate
+        // after a bounded interval, including if the admission assertion fails.
+        let gate: ID3D12Fence = unsafe { host.device.CreateFence(0, D3D12_FENCE_FLAG_NONE).unwrap() };
+        unsafe { host.queue.Wait(&gate, 1).unwrap(); }
+        let release = gate.clone();
+        let (go, start) = std::sync::mpsc::channel();
+        let opener = std::thread::spawn(move || {
+            let _ = start.recv_timeout(std::time::Duration::from_secs(2));
+            std::thread::sleep(std::time::Duration::from_millis(45));
+            unsafe { release.Signal(1).unwrap(); }
+        });
+        host.execute_own(&producer);
+        let live = LIVE_FETCH.load(Ordering::Acquire);
+        go.send(()).unwrap();
+        host.execute_own(&next);
+        let admitted_while_live = LIVE_FETCH.load(Ordering::Acquire);
+        opener.join().unwrap();
+        settle_now(WHY_SYNC);
+        assert!(live);
+        assert!(!admitted_while_live);
+        assert!(!LIVE_FETCH.load(Ordering::Acquire));
+        assert_eq!(title[0], 17);
+        crate::shadow::unregister(address, address as u64);
+    }
+
+    #[test]
+    fn relay_fetch_observes_the_producer_with_a_later_write_already_complete() {
+        if std::env::var_os("VICTORY_TEST_RELAY_SNAPSHOT").is_none() {
+            let thread = std::thread::current();
+            let result = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", thread.name().unwrap(), "--nocapture"])
+                .env("VICTORY_TEST_RELAY_SNAPSHOT", "1")
+                .env("VICTORY_RELAY", "2")
+                .env("VICTORY_KEEP_SNAPSHOTS", "0")
+                .env("VICTORY_CARD_BUFFERS", "1")
+                .env("VICTORY_CARD_BUFFERS_MIN_MB", "1")
+                .status()
+                .unwrap();
+            assert!(result.success());
+            return;
+        }
+        let host = host().expect("D3D12 device");
+        const WORDS: usize = 1024 * 1024 / 4;
+        let mut title = vec![0u32; WORDS];
+        let address = title.as_mut_ptr() as usize;
+        crate::shadow::register(address, address as u64, (WORDS * 4) as u64);
+        let shadow = crate::shadow::find(address as u64, 4).unwrap();
+        assert!(shadow.carded());
+        let put = |list: &HostList, value: u32| {
+            let (upload, data) = host.upload_buffer(4).unwrap();
+            // SAFETY: mapped four-byte upload, live buffers; the list retains the upload.
+            unsafe {
+                data.cast::<u32>().write_unaligned(value);
+                list.list.CopyBufferRegion(&shadow.buffer, 0, &upload, 0, 4);
+                list.list.ResourceBarrier(&[transition(
+                    &shadow.buffer,
+                    D3D12_RESOURCE_STATE_COPY_DEST,
+                    D3D12_RESOURCE_STATE_COMMON,
+                )]);
+            }
+            list.keep(&upload);
+        };
+        let producer = host.new_list().unwrap();
+        shadow.refresh(&producer, address as u64, 4);
+        shadow.gpu_writes(&producer, address as u64, 4);
+        put(&producer, 17);
+        producer.close();
+        let (submitted, mut sent) = host.submit(&[&producer], true).unwrap();
+        let completed = *submitted;
+        drop(submitted);
+        let plan = sent.card.take().unwrap();
+        let next = host.new_list().unwrap();
+        put(&next, 29);
+        next.close();
+        // A deterministic interleaving: the later DIRECT write completes before
+        // the relay fetch starts. No queues access a racing resource in this test.
+        unsafe {
+            let fence: ID3D12Fence = host.device.CreateFence(0, D3D12_FENCE_FLAG_NONE).unwrap();
+            host.queue
+                .ExecuteCommandLists(&[Some(next.list.cast().unwrap())]);
+            host.queue.Signal(&fence, 1).unwrap();
+            fence.SetEventOnCompletion(1, Default::default()).unwrap();
+        }
+        host.relay_card_back(&[&plan], completed, &mut None);
+        let seen = title[0];
+        let restore = host.new_list().unwrap();
+        put(&restore, 17);
+        restore.close();
+        unsafe {
+            let fence: ID3D12Fence = host.device.CreateFence(0, D3D12_FENCE_FLAG_NONE).unwrap();
+            host.queue
+                .ExecuteCommandLists(&[Some(restore.list.cast().unwrap())]);
+            host.queue.Signal(&fence, 1).unwrap();
+            fence.SetEventOnCompletion(1, Default::default()).unwrap();
+        }
+        host.card_done(plan);
+        for (s, ranges) in sent.back {
+            s.copy_back_done(&ranges);
+        }
+        crate::shadow::unregister(address, address as u64);
+        assert_eq!(
+            seen, 17,
+            "read-back must correspond to the producer's completed flight"
+        );
+    }
+}
