+#[test]
+fn copied_arguments_replace_a_prefetched_record() {
+    if std::env::var("VICTORY_INDIRECT_WINDOW").as_deref() != Ok("1") {
+        let this = std::thread::current();
+        assert!(std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", this.name().unwrap(), "--nocapture"])
+            .env("VICTORY_INDIRECT_WINDOW", "1").status().unwrap().success());
+        return;
+    }
+    if !have_adapter() { return; }
+    let triangle = ready_triangle(&host().unwrap().device);
+    let mut words = vec![0u32; 4 * 24];
+    for r in words.chunks_exact_mut(4) { r.copy_from_slice(&[3, 1, 0, 0]); }
+    let args = TitleBuffer::new(words);
+    let replacement = [0u32, 1, 0, 0];
+    let (_, stats) = render(&triangle, None, |state, list| {
+        for record in 0..3 {
+            if record == 2 {
+                list.defer_copy(args.at(8) as *mut u8, replacement.as_ptr().cast(), 16);
+            }
+            assert!(state.execute_indirect(list, (0, 16, 1), args.at(record * 4), None));
+        }
+    });
+    assert_eq!(stats.IAVertices, 6, "third draw reads zero vertices after the copy");
+}
