+#[test]
+#[ignore = "GPU timestamp benchmark"]
+fn measure_indirect() {
+    use windows::Win32::Graphics::Dxgi::*;
+    use std::time::Instant;
+    let host = host().unwrap();
+    let pipeline = ready_compute();
+    // SAFETY: use the adapter of this device and the direct queue's timestamp clock.
+    let (adapter, frequency) = unsafe {
+        let factory: IDXGIFactory4 = CreateDXGIFactory2(DXGI_CREATE_FACTORY_FLAGS(0)).unwrap();
+        let adapter: IDXGIAdapter3 = factory.EnumAdapterByLuid(host.device.GetAdapterLuid()).unwrap();
+        (adapter, host.review_timestamp_frequency())
+    };
+    let info = unsafe { adapter.GetDesc1().unwrap() };
+    let soft = info.Flags & DXGI_ADAPTER_FLAG_SOFTWARE.0 as u32 != 0;
+    assert_eq!(soft, std::env::var_os("VICTORY_D3D12_WARP").is_some());
+    eprintln!("DEVICE software={soft} vendor={:04x} device={:04x} hz={frequency}", info.VendorId, info.DeviceId);
+    let usage = |segment| {
+        let mut info = DXGI_QUERY_VIDEO_MEMORY_INFO::default();
+        // SAFETY: one node, the adapter's own output structure.
+        unsafe { adapter.QueryVideoMemoryInfo(0,segment,&mut info).ok().map(|_| info.CurrentUsage) }
+    };
+    let mut time_heap=None;
+    let mut stats_heap=None;
+    // SAFETY: owned out pointers for two direct-list query heaps.
+    unsafe {
+        for (kind, count, dest) in [(D3D12_QUERY_HEAP_TYPE_TIMESTAMP,2,&mut time_heap),
+                (D3D12_QUERY_HEAP_TYPE_PIPELINE_STATISTICS,1,&mut stats_heap)] {
+            host.device.CreateQueryHeap(&D3D12_QUERY_HEAP_DESC{Type:kind,Count:count,NodeMask:0},dest).unwrap();
+        }
+    }
+    let time_heap: ID3D12QueryHeap=time_heap.unwrap();
+    let stats_heap: ID3D12QueryHeap=stats_heap.unwrap();
+    let (times, time_ptr)=host.shared_buffer(16).unwrap();
+    let (stats, stats_ptr)=host.shared_buffer(size_of::<D3D12_QUERY_DATA_PIPELINE_STATISTICS>() as u64).unwrap();
+    for (case, maximum, active, calls) in [("empty",0,0,1),("one",1,1,1),("dense16",16,16,1),
+          ("dense64",64,64,1),("dense256",256,256,1),("zero1024",1024,0,1),
+          ("one4096",4096,1,1),("zero4096",4096,0,1),("four64",64,64,4)] {
+        let args=TitleBuffer::new([1,1,1].repeat(maximum.max(1) as usize));
+        let count=TitleBuffer::new(vec![active]);
+        let list=host.new_list().unwrap();
+        let before=(usage(DXGI_MEMORY_SEGMENT_GROUP_LOCAL),usage(DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL));
+        for iteration in 0..9 {
+            if iteration>0 {list.reset();}
+            let mut state=State::default();
+            state.reset(&pipeline.object);
+            // SAFETY: the heaps and mapped result buffers outlive all submissions.
+            unsafe {
+                list.list.BeginQuery(&stats_heap,D3D12_QUERY_TYPE_PIPELINE_STATISTICS,0);
+                list.list.EndQuery(&time_heap,D3D12_QUERY_TYPE_TIMESTAMP,0);
+            }
+            let record=Instant::now();
+            for _ in 0..calls {
+                let accepted=state.execute_indirect(&list,(2,12,maximum),args.at(0),Some(count.at(0)));
+                assert!(accepted || maximum == 0);
+            }
+            let cpu_ns=record.elapsed().as_nanos();
+            unsafe {
+                list.list.EndQuery(&time_heap,D3D12_QUERY_TYPE_TIMESTAMP,1);
+                list.list.EndQuery(&stats_heap,D3D12_QUERY_TYPE_PIPELINE_STATISTICS,0);
+                list.list.ResolveQueryData(&time_heap,D3D12_QUERY_TYPE_TIMESTAMP,0,2,&times,0);
+                list.list.ResolveQueryData(&stats_heap,D3D12_QUERY_TYPE_PIPELINE_STATISTICS,0,1,&stats,0);
+            }
+            list.close();
+            let submit=Instant::now();
+            host.execute(&[&list]);
+            let submit_ns=submit.elapsed().as_nanos();
+            let ticks=unsafe{time_ptr.cast::<[u64;2]>().read()};
+            let cs=unsafe{stats_ptr.cast::<D3D12_QUERY_DATA_PIPELINE_STATISTICS>().read().CSInvocations};
+            assert!(ticks[1]>=ticks[0]);
+            let gpu_ns=(ticks[1]-ticks[0]) as f64*1e9/frequency as f64;
+            if iteration==0 {
+                let after=(usage(DXGI_MEMORY_SEGMENT_GROUP_LOCAL),usage(DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL));
+                eprintln!("MEM {case} local_before={:?} local_after={:?} nonlocal_before={:?} nonlocal_after={:?}",before.0,after.0,before.1,after.1);
+            }
+            if iteration>=2 {eprintln!("SAMPLE {case} {maximum} {active} {calls} {iteration} {cpu_ns} {gpu_ns:.0} {submit_ns} {cs}");}
+            // Keep sampled workloads comfortably below the observed driver timeout.
+            if gpu_ns>300_000_000.0 { panic!("timing guard at {case}: {gpu_ns} ns"); }
+        }
+    }
+}
