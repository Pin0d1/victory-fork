+#[cfg(test)]
+pub(crate) fn audit_pending_words_at(address: usize, values: &[u64]) {
+    let mut l = line();
+    assert!(l.line.iter().all(|x| matches!(x, Late::Write(..))));
+    l.line = values.iter().map(|&v| Late::Write(address, crate::queue::Written::Value(v), 8)).collect();
+}
